    .scope S_0x5a9addeae550;
T_3 ;
    %vpi_call/w 3 38 "$dumpfile", "sim/digital_lock_controller_3.vcd" {0 0 0};
    %vpi_call/w 3 39 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5a9addeae550 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a9addec4ba0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a9addec4e40_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a9addec4d70_0, 0, 1;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5a9addec4c70_0, 0, 4;
    %delay 20000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a9addec4e40_0, 0, 1;
    %delay 20000, 0;
    %vpi_call/w 3 55 "$display", "RESET TEST COMPLETED" {0 0 0};
    %vpi_call/w 3 56 "$finish" {0 0 0};
