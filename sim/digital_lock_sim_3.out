    %flag_set/vec4 8;
    %jmp/0xz  T_1.2, 8;
    %load/vec4 v0x5a9addec4390_0;
    %cmpi/e 5, 0, 4;
    %jmp/0xz  T_1.4, 4;
    %pushi/vec4 1, 0, 1;
    %assign/vec4 v0x5a9addec4640_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x5a9adde72640_0, 0;
