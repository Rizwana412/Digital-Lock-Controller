    %assign/vec4 v0x5a9addec4640_0, 0;
    %pushi/vec4 1, 0, 1;
    %assign/vec4 v0x5a9adde72640_0, 0;
T_1.5 ;
T_1.2 ;
T_1.1 ;
    %jmp T_1;
    .thread T_1;
    .scope S_0x5a9addeae550;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v0x5a9addec4ba0_0;
    %inv;
    %store/vec4 v0x5a9addec4ba0_0, 0, 1;
    %jmp T_2;
