v0x5a9addec4580_0 .net "reset", 0 0, v0x5a9addec4e40_0;  1 drivers
v0x5a9addec4640_0 .var "unlock", 0 0;
E_0x5a9adde72ed0 .event posedge, v0x5a9addec4580_0, v0x5a9addec4210_0;
S_0x5a9addec47c0 .scope task, "enter_digit" "enter_digit" 3 27, 3 27 0, S_0x5a9addeae550;
 .timescale -9 -12;
v0x5a9addec49e0_0 .var "d", 3 0;
E_0x5a9addeab980 .event negedge, v0x5a9addec4210_0;
TD_digital_lock_controller_tb.enter_digit ;
    %wait E_0x5a9addeab980;
    %load/vec4 v0x5a9addec49e0_0;
    %store/vec4 v0x5a9addec4c70_0, 0, 4;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a9addec4d70_0, 0, 1;
    %wait E_0x5a9addeab980;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a9addec4d70_0, 0, 1;
    %end;
    .scope S_0x5a9adde72490;
T_1 ;
    %wait E_0x5a9adde72ed0;
    %load/vec4 v0x5a9addec4580_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.0, 8;
    %pushi/vec4 0, 0, 4;
