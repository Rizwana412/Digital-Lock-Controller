#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x61d6821703f0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x61d682170580 .scope module, "digital_lock_controller_tb" "digital_lock_controller_tb" 3 3;
 .timescale -9 -12;
v0x61d68218b1e0_0 .net "alarm", 0 0, v0x61d68215f630_0;  1 drivers
v0x61d68218b2a0_0 .var "clk", 0 0;
v0x61d68218b340_0 .var "digit", 3 0;
v0x61d68218b3e0_0 .var "enter", 0 0;
v0x61d68218b4b0_0 .var "reset", 0 0;
v0x61d68218b5a0_0 .net "unlock", 0 0, v0x61d68218ad40_0;  1 drivers
S_0x61d682134490 .scope module, "dut" "digital_lock_controller" 3 14, 4 1 0, S_0x61d682170580;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset";
    .port_info 2 /INPUT 1 "enter";
    .port_info 3 /INPUT 4 "digit";
    .port_info 4 /OUTPUT 1 "unlock";
    .port_info 5 /OUTPUT 1 "alarm";
v0x61d68215f630_0 .var "alarm", 0 0;
v0x61d68215b320_0 .net "clk", 0 0, v0x61d68218b2a0_0;  1 drivers
v0x61d68218a9d0_0 .var "count", 3 0;
v0x61d68218aa90_0 .net "digit", 3 0, v0x61d68218b340_0;  1 drivers
v0x61d68218ab70_0 .net "enter", 0 0, v0x61d68218b3e0_0;  1 drivers
v0x61d68218ac80_0 .net "reset", 0 0, v0x61d68218b4b0_0;  1 drivers
v0x61d68218ad40_0 .var "unlock", 0 0;
E_0x61d682134ed0 .event posedge, v0x61d68218ac80_0, v0x61d68215b320_0;
S_0x61d68218aec0 .scope task, "enter_digit" "enter_digit" 3 27, 3 27 0, S_0x61d682170580;
 .timescale -9 -12;
v0x61d68218b0e0_0 .var "d", 3 0;
E_0x61d68216d980 .event negedge, v0x61d68215b320_0;
TD_digital_lock_controller_tb.enter_digit ;
    %wait E_0x61d68216d980;
    %load/vec4 v0x61d68218b0e0_0;
    %store/vec4 v0x61d68218b340_0, 0, 4;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x61d68218b3e0_0, 0, 1;
    %wait E_0x61d68216d980;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x61d68218b3e0_0, 0, 1;
    %end;
    .scope S_0x61d682134490;
T_1 ;
    %wait E_0x61d682134ed0;
    %load/vec4 v0x61d68218ac80_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.0, 8;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v0x61d68218a9d0_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x61d68218ad40_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x61d68215f630_0, 0;
    %jmp T_1.1;
T_1.0 ;
    %load/vec4 v0x61d68218ab70_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.2, 8;
    %load/vec4 v0x61d68218aa90_0;
    %cmpi/e 5, 0, 4;
    %jmp/0xz  T_1.4, 4;
    %pushi/vec4 1, 0, 1;
    %assign/vec4 v0x61d68218ad40_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x61d68215f630_0, 0;
    %jmp T_1.5;
T_1.4 ;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x61d68218ad40_0, 0;
    %pushi/vec4 1, 0, 1;
    %assign/vec4 v0x61d68215f630_0, 0;
T_1.5 ;
T_1.2 ;
T_1.1 ;
    %jmp T_1;
    .thread T_1;
    .scope S_0x61d682170580;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v0x61d68218b2a0_0;
    %inv;
    %store/vec4 v0x61d68218b2a0_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x61d682170580;
T_3 ;
    %vpi_call/w 3 39 "$dumpfile", "sim/digital_lock_controller.vcd" {0 0 0};
    %vpi_call/w 3 40 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x61d682170580 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x61d68218b2a0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x61d68218b4b0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x61d68218b3e0_0, 0, 1;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x61d68218b340_0, 0, 4;
    %delay 20000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x61d68218b4b0_0, 0, 1;
    %vpi_call/w 3 52 "$display", "TEST 1: Correct input" {0 0 0};
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x61d68218b0e0_0, 0, 4;
    %fork TD_digital_lock_controller_tb.enter_digit, S_0x61d68218aec0;
    %join;
    %delay 10000, 0;
    %load/vec4 v0x61d68218b5a0_0;
    %cmpi/e 1, 0, 1;
    %jmp/0xz  T_3.0, 4;
    %vpi_call/w 3 58 "$display", "TEST 1 PASSED: Unlock activated" {0 0 0};
    %jmp T_3.1;
T_3.0 ;
    %vpi_call/w 3 60 "$display", "TEST 1 FAILED: Unlock not activated" {0 0 0};
T_3.1 ;
    %wait E_0x61d68216d980;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x61d68218b4b0_0, 0, 1;
    %wait E_0x61d68216d980;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x61d68218b4b0_0, 0, 1;
    %vpi_call/w 3 69 "$display", "TEST 2: Wrong input" {0 0 0};
    %pushi/vec4 7, 0, 4;
    %store/vec4 v0x61d68218b0e0_0, 0, 4;
    %fork TD_digital_lock_controller_tb.enter_digit, S_0x61d68218aec0;
    %join;
    %delay 10000, 0;
    %load/vec4 v0x61d68218b1e0_0;
    %cmpi/e 1, 0, 1;
    %jmp/0xz  T_3.2, 4;
    %vpi_call/w 3 75 "$display", "TEST 2 PASSED: Alarm activated" {0 0 0};
    %jmp T_3.3;
T_3.2 ;
    %vpi_call/w 3 77 "$display", "TEST 2 FAILED: Alarm not activated" {0 0 0};
T_3.3 ;
    %delay 20000, 0;
    %vpi_call/w 3 81 "$display", "Simulation completed." {0 0 0};
    %vpi_call/w 3 82 "$finish" {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb/digital_lock_controller_tb.sv";
    "rtl/digital_lock_controller.sv";
